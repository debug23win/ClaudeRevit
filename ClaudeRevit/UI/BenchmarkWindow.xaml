<Window x:Class="ClaudeRevit.UI.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Revit — Model benchmark"
        Width="1180" Height="740"
        WindowStartupLocation="CenterOwner"
        MinWidth="780" MinHeight="520"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">

        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Run with:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="BackendBox" Width="180" SelectionChanged="Backend_Changed">
                    <ComboBoxItem Tag="codex" IsSelected="True">Codex · subscription</ComboBoxItem>
                    <ComboBoxItem Tag="claudecode">Claude Code · subscription</ComboBoxItem>
                    <ComboBoxItem Tag="api">API · per-token billing</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Model:" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox x:Name="ModelBox" Width="210" IsEditable="True" DisplayMemberPath="Label" SelectionChanged="Model_Changed" />
                <ComboBox x:Name="EffortBox" Width="85" Margin="6,0,0,0" ToolTip="Reasoning effort supported by the selected model." />
                <Button Content="Refresh models" Click="Refresh_Click" Margin="10,0,0,0" Padding="6,2" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Judge with:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="JudgeBackendBox" Width="180" SelectionChanged="Backend_Changed">
                    <ComboBoxItem Tag="codex" IsSelected="True">Codex · subscription</ComboBoxItem>
                    <ComboBoxItem Tag="claudecode">Claude Code · subscription</ComboBoxItem>
                    <ComboBoxItem Tag="api">API · per-token billing</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Model:" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox x:Name="JudgeBox" Width="210" IsEditable="True" DisplayMemberPath="Label" SelectionChanged="Model_Changed" />
                <ComboBox x:Name="JudgeEffortBox" Width="85" Margin="6,0,0,0" />
            </WrapPanel>
            <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap" Foreground="#B26A00" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Tasks:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="TaskSetBox" Width="220">
                    <ComboBoxItem Tag="all" IsSelected="True">All tasks (29)</ComboBoxItem>
                    <ComboBoxItem Tag="basic">Basics</ComboBoxItem>
                    <ComboBoxItem Tag="composite">Composite tasks</ComboBoxItem>
                    <ComboBoxItem Tag="domain">Rebar and steel</ComboBoxItem>
                    <ComboBoxItem Tag="docs">Sheets, schedules and tags</ComboBoxItem>
                    <ComboBoxItem Tag="hard">Hard tasks</ComboBoxItem>
                    <ComboBoxItem Tag="family">Complex families (open RFA)</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Task limit:" VerticalAlignment="Center" Margin="10,0,6,0" />
                <TextBox x:Name="MaxRoundsBox" Text="60" Width="38" VerticalContentAlignment="Center" />
                <TextBlock Text="rounds/tool calls or" VerticalAlignment="Center" Margin="6,0" />
                <TextBox x:Name="MaxMinutesBox" Text="15" Width="38" VerticalContentAlignment="Center" />
                <TextBlock Text="min (0 = unlimited)" VerticalAlignment="Center" Margin="6,0" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="RunButton" Content="Run benchmark" Width="130" Height="28" Click="RunButton_Click" />
                <Button x:Name="CancelButton" Content="Stop" Width="70" Height="28" Margin="8,0" Click="CancelButton_Click" IsEnabled="False" />
                <CheckBox x:Name="ResetBox" Content="Use fresh document copy per task" IsChecked="True" VerticalAlignment="Center" Margin="8,0" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                Text="Save a local non-workshared scratch RVT or ordinary RFA first, with no unsaved edits. Each task uses a temporary copy, then closes it unsaved and restores the seed. Exported files remain. F2 needs editable nested children; F3 needs two nesting levels. Incompatible tasks are skipped without points. Subscription is the default; API billing is explicit. Keep judge, seed and limits fixed. Results: benchmark_results.jsonl in the ClaudeRevit settings folder." />
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                Text="Quality: independent judge, 0–100. Speed: 100 × min(1, reference time / actual time). Total: quality × (0.8 + 0.2 × speed / 100). Fixed per-task reference times are provisional, not calibrated performance targets. Time includes modelling and tools; probes, judging and reset are excluded." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#EEF4FF" BorderBrush="#CFE0FF" BorderThickness="1"
                Padding="8,5" Margin="0,0,0,8" x:Name="NowPanel" Visibility="Collapsed">
            <TextBlock x:Name="NowText" FontFamily="Consolas" FontSize="12"
                       Text="idle" TextTrimming="CharacterEllipsis"
                       ToolTip="The clock keeps ticking while it works — if it freezes for a long time, Revit is busy on a heavy operation." />
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,90,0" TextWrapping="Wrap" />
            <Button x:Name="CloseButton" Content="Close" Width="80" Height="26" HorizontalAlignment="Right"
                    Click="CloseButton_Click" />
        </Grid>

        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Task" Binding="{Binding TaskId}" Width="46" />
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="150" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="150" />
                <DataGridTextColumn Header="✓/✗" Binding="{Binding Verdict}" Width="40" />
                <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="58" />
                <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="58" />
                <DataGridTextColumn Header="Total /100" Binding="{Binding Score}" Width="72" />
                <DataGridTextColumn Header="Rounds" Binding="{Binding Rounds}" Width="60" />
                <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens}" Width="80" />
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="60" />
                <DataGridTextColumn Header="Revit" Binding="{Binding RevitTime}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="Summed Revit dispatcher execution, including transactions. Total Time also includes model/setup and queue waits. Detailed phase timings are saved to JSONL. Available for subscription runs." />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Judge reason" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
